FROM node:22-bookworm-slim AS node
FROM python:3.12-slim-bookworm
COPY --from=node /usr/local/bin/node /usr/local/bin/node
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 ca-certificates && rm -rf /var/lib/apt/lists/*
RUN groupadd --gid 10001 mwevent && useradd --uid 10001 --gid 10001 --create-home mwevent
WORKDIR /app
COPY railway-shadow/requirements-event-runtime.txt /app/requirements-event-runtime.txt
COPY railway-shadow/requirements-backup.txt /app/requirements-backup.txt
RUN pip install --no-cache-dir -r /app/requirements-event-runtime.txt -r /app/requirements-backup.txt
COPY . /app
ENV PYTHONUNBUFFERED=1
CMD ["python", "railway-shadow/event_runtime_staging.py"]
