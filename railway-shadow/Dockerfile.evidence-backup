FROM node:22-bookworm-slim AS node_runtime
FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 masterwok
COPY --from=node_runtime /usr/local/bin/node /usr/local/bin/node
WORKDIR /app/master-wok
COPY railway-shadow/requirements-backup.txt /tmp/requirements-backup.txt
RUN pip install --no-cache-dir -r /tmp/requirements-backup.txt
COPY . .
ENV PYTHONUNBUFFERED=1 TZ=Europe/London MASTER_WOK_COLLECTOR_ENABLED=false MASTER_WOK_DELIVERY_EVIDENCE_ENABLED=false MASTER_WOK_EVIDENCE_BACKUP_ENABLED=false
USER masterwok
CMD ["python", "railway-shadow/delivery_evidence_collector.py"]
