# Build from the master-wok directory: docker build -f railway-shadow/Dockerfile.comparison-staging .
# Prepared configuration only; container build has not been run in this workspace.
FROM node:22-bookworm-slim AS node_runtime
FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 masterwok
COPY --from=node_runtime /usr/local/bin/node /usr/local/bin/node
WORKDIR /app/master-wok
COPY railway-shadow/requirements-backup.txt /tmp/requirements-backup.txt
RUN pip install --no-cache-dir -r /tmp/requirements-backup.txt
COPY . .
ENV PYTHONUNBUFFERED=1 TZ=Europe/London MASTER_WOK_COLLECTOR_ENABLED=false MASTER_WOK_COMPARISON_STAGING_ENABLED=false MASTER_WOK_COMPARISON_BACKUP_ENABLED=false
USER root
ENTRYPOINT ["python", "railway-shadow/comparison_entrypoint.py"]
